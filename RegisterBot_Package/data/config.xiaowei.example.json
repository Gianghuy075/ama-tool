{
    "base_url": "http://localhost:8000",
    "product_url": "https://www.amazon.co.jp/dp/REPLACE_WITH_REAL_ASIN",
    "max_concurrent_tasks": 3,
    "headless": true,
    "gmail_address": "replace-with-gmail@example.com",
    "gmail_app_password": "replace-with-app-password",
    "imap_server": "imap.gmail.com",
    "otp_wait_seconds": 90,
    "delay_between_accounts": 3,
    "proxy": {
        "enable": false,
        "server": "",
        "change_ip_url": "",
        "change_ip_delay": 15,
        "verify_ip": false
    },
    "selectors": {
        "name": "input[name=\"name\"], input[name=\"full_name\"], input#name",
        "email": "input[name=\"email\"], input[type=\"email\"]",
        "password": "input[name=\"password\"], input[type=\"password\"]",
        "submit": "button[type=\"submit\"], input[type=\"submit\"]",
        "otp": "input[name=\"otp\"], input[name=\"code\"], input.otp-input, input[maxlength=\"6\"]",
        "otp_submit": "button[type=\"submit\"], input[type=\"submit\"]"
    },
    "xiaowei": {
        "enable": true,
        "api_type": "xiaowei",
        "api_url": "http://REPLACE_WITH_REAL_XIAOWEI_HOST:PORT",
        "devices": "all",
        "otp_source": "gmail",
        "screenshot_dir": "data/screenshots",
        "tap_delay": [
            0.5,
            1.5
        ],
        "human_typing": {
            "char_delay_min": 0.08,
            "char_delay_max": 0.22,
            "thinking_time_min": 0.8,
            "thinking_time_max": 1.8,
            "typo_enabled": true,
            "typo_probability": 0.05,
            "typo_pause_before_backspace": 0.3,
            "typo_pause_after_backspace": 0.15
        }
    }
}
