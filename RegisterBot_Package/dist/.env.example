# ──────────────────────────────────────────────
# .env – Cấu hình môi trường
# Copy file này thành .env.test và .env.production
# KHÔNG commit file .env lên git
# ──────────────────────────────────────────────

# "development" | "test" | "production"
APP_ENV=test

# reCAPTCHA (chỉ cần điền khi APP_ENV=production)
RECAPTCHA_SECRET_KEY=your_google_recaptcha_secret_here
RECAPTCHA_SITE_KEY=your_google_recaptcha_site_key_here

# Key bí mật để bypass CAPTCHA khi test
# Đặt giá trị ngẫu nhiên, khó đoán
CAPTCHA_TEST_KEY=TEST_BYPASS_123
